{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@driveloader/react": [
        "../src/index.ts"
      ],
      "@driveloader/react/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/index.ts",
    "../src/components/**/*",
    "../src/hooks/**/*",
    "../src/core/**/*",
    "../src/context/**/*",
    "../src/utils/**/*",
    "../src/types/**/*",
    "../src/errors/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../dist-docs",
    "../src/tests",
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx"
  ]
}
